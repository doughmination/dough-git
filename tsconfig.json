{
  "extends": "$app/tsconfig",
  "include": ["src", "test", "worker", "container", "*.ts", "worker-configuration.d.ts"],
  "exclude": ["build", "node_modules"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["$app/types", "bun"]
  }
}
