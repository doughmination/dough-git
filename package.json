{
  "name": "dough-git",
  "version": "1.0.0",
  "description": "A minimal self-hosted git mirror: HTTP clone/pull/push + cgit-style viewer, gated by OIDC SSO.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test/run.ts"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "hono": "^4.13.8",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
