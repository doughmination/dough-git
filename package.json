{
  "name": "dough-git",
  "version": "2.0.0",
  "description": "A minimal git mirror on Cloudflare: HTTP clone/pull/push + cgit-style viewer, gated by OIDC SSO.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "bun run check",
    "test": "bun test/run.ts",
    "preview": "wrangler dev",
    "deploy": "wrangler d1 migrations apply dough-git --remote && wrangler deploy",
    "types": "wrangler types",
    "agent": "MINIGIT_REPOS_ROOT=./data/repos bun container/server.ts"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "iconsax": "^0.1.1",
    "openid-client": "^6.8.8",
    "simple-icons": "npm:@icons-pack/svelte-simple-icons@^7.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "4.154.0"
  }
}
