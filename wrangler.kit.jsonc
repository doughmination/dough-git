// wrangler.kit.jsonc
// LICENCED DASL-1.0 (c) Clove Twilight
// What adapter-cloudflare builds into, and what `vite dev` binds. Deploys use
// wrangler.jsonc, whose worker/index.ts wraps this build with the container and cron
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dough-git",
  // Clove Twilight Team
  "account_id": "f87ee4b9600f437b8da1104d077418c3",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dough-git",
      "database_id": "6924b245-00d1-43b8-aafb-c359f920232a",
      "migrations_dir": "migrations"
    }
  ]
}
